HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/app.db
SESSION_COOKIE_NAME=haf_session

# Public HTTPS origin behind a reverse proxy; required for form origin checks.
APP_ORIGIN=
# Only enable fictitious profiles in an isolated development database.
DEMO_DATA=0

# Optional Sites owner bootstrap: requires a matching verified dispatcher identity.
ADMIN_EMAIL=
